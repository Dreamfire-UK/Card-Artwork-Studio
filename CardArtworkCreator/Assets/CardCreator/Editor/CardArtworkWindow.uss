.card-creator { flex-grow: 1; background-color: rgb(16, 23, 25); color: rgb(225, 229, 219); }
.studio-header { padding: 14px 18px 12px 18px; background-color: rgb(22, 33, 34); border-bottom-width: 1px; border-bottom-color: rgb(80, 68, 53); }
.studio-brand { font-size: 18px; -unity-font-style: bold; color: rgb(236, 225, 201); letter-spacing: 2px; }
.studio-eyebrow { font-size: 10px; color: rgb(172, 152, 119); margin-top: 4px; letter-spacing: 1px; }
.card-creator__toolbar { flex-direction: row; align-items: center; padding: 10px 14px; background-color: rgb(24, 34, 35); }
.card-creator__card-field { flex-grow: 1; margin-right: 8px; min-width: 200px; }
.card-creator__content { flex-direction: row; flex-grow: 1; min-height: 0; }
.card-creator__editor { width: 46%; min-width: 360px; border-right-width: 1px; border-right-color: rgb(53, 65, 61); }
.studio-tabs { flex-direction: row; padding: 10px 12px 0 12px; }
.studio-tab { flex-grow: 1; height: 32px; margin: 0 2px; border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
.studio-fields { flex-grow: 1; padding: 0 14px 14px 14px; }
.studio-section { color: rgb(209, 176, 133); font-size: 12px; -unity-font-style: bold; margin: 18px 0 8px 0; padding-bottom: 7px; border-bottom-width: 1px; border-bottom-color: rgb(57, 69, 62); }
.studio-hint { color: rgb(152, 165, 157); font-size: 11px; white-space: normal; margin: 6px 0; }
.studio-empty { white-space: normal; color: rgb(169, 183, 171); font-size: 14px; margin-top: 26px; }
.card-creator__right { flex-grow: 1; min-width: 420px; padding: 10px 16px 12px 16px; }
.preview-header { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 10px; }
.preview-header > .studio-eyebrow { flex-shrink: 1; white-space: normal; margin-right: 8px; }
.studio-row { flex-direction: row; align-items: center; }
.stance-button { width: 64px; height: 28px; }
.preview-scroll { flex-grow: 1; min-height: 200px; background-color: rgb(10, 17, 19); border-top-width: 1px; border-top-color: rgb(48, 62, 57); }
.preview-scroll .unity-scroll-view__content-container { align-items: center; }
.card-creator__preview { width: 375px; height: 525px; margin: 12px 0; }
.preview-controls { flex-direction: row; justify-content: space-between; align-items: center; margin-top: 6px; }
.card-creator__export { height: 35px; margin-top: 8px; background-color: rgb(61, 100, 78); color: rgb(244, 237, 219); -unity-font-style: bold; }
.card-creator__status { white-space: normal; font-size: 11px; color: rgb(145, 167, 150); margin-top: 6px; }
.has-warning { color: rgb(229, 177, 103); }
.card-creator Button { background-color: rgb(34, 47, 47); border-top-color: rgb(67, 82, 74); border-right-color: rgb(67, 82, 74); border-bottom-color: rgb(67, 82, 74); border-left-color: rgb(67, 82, 74); color: rgb(219, 224, 212); padding: 4px 8px; }
.card-creator Button:hover { background-color: rgb(53, 73, 63); }
.card-creator Button.is-selected { background-color: rgb(79, 91, 67); border-bottom-color: rgb(212, 164, 103); color: rgb(255, 237, 206); }
.card-creator Button.card-creator__export { background-color: rgb(61, 100, 78); }
.arrow-grid { width: 153px; flex-direction: row; flex-wrap: wrap; align-self: center; margin: 8px 0; }
.arrow-toggle { width: 47px; height: 39px; margin: 2px; font-size: 23px; }
.art-library__grid { flex-direction: row; flex-wrap: wrap; margin: 8px 0; }
.art-library__tile { width: 30%; height: 112px; margin: 1.5%; padding: 4px; }
.art-library__thumbnail { width: 100%; height: 70px; }
.art-library__name { font-size: 10px; white-space: normal; -unity-text-align: middle-center; overflow: hidden; height: 30px; }
.art-library__page { flex-grow: 1; -unity-text-align: middle-center; font-size: 10px; }
.arrow-grid { width: 168px; flex-direction: column; flex-wrap: nowrap; }
.card-creator Button.arrow-toggle { width: 48px; min-width: 48px; height: 40px; margin: 2px; padding: 0; flex-shrink: 0; }
.studio-fields .unity-decorator-drawers-container { display: none; }
